{
  "name": "ai-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "AI Portfolio - Personal AI Portfolio",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "docker compose watch",
    "up": "docker compose up -d",
    "down": "docker compose down",
    "logs": "docker compose logs -f",
    "build": "docker compose build",
    "ps": "docker compose ps",
    "clean": "docker compose down -v",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ibhaudur/ai-portfolio.git"
  },
  "keywords": [
    "nextjs",
    "express",
    "fastapi",
    "postgres",
    "docker"
  ],
  "author": "Ibhaudur Rahman",
  "license": "ISC",
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0"
  },
  "lint-staged": {
  "apps/web/**/*.{js,jsx,ts,tsx}": [
    "eslint --config apps/web/eslint.config.mjs --fix"
  ]
}
}
